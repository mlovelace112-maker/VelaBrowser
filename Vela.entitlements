<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The app sandbox is off so Vela can read Safari's bookmarks (with Full Disk Access).
	     The hardened runtime (in the build settings) still protects Vela from code injection. -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Let websites use the camera and microphone (only after you say yes
	     in Vela, and macOS asks once too). The hardened runtime blocks them without these. -->
	<key>com.apple.security.device.camera</key>
	<true/>
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- Builds signed "to run locally" have no team ID, so macOS would refuse
	     to load the Sparkle updater framework into Vela without this. -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
